<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <title>Recipe Generator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include('nav'); -%>
        <% if (user != 'guest') {%>
            <main class="h-screen grid grid-rows-8">
                <div class="bg-emerald-950 row-start-2 row-span-5 text-white">
                <form autocomplete="off" action="/addItem" method="post">
                    <div class="autocomplete" style="width:100%;">
                      <input class="w-screen" id="myInput" type="text" name="ingredient" placeholder="Corn">
                    </div>
                    <input type="submit">
                  </form>
            </div>
            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>
        </script> 
    </body>
</html>