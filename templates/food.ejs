<!DOCTYPE HTML>
<html>
    <head>
        <meta charset="utf-8">
        <title>Drink Curator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include ('nav'); -%>
        <% if (user != 'guest') {%>
            <main class="h-screen flex flex-col">
                <div class="h-1/7 flex-none w-screen bg-black"></div>
                <div class="bg-emerald-950 h-4/5 flex flex-col text-white">
                    <div class="max-h-1/2 h-full flex flex-row">
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Favorite Meal</h1>
                            <div class="h-full border shadow-xl bg-slate-800 overflow-y-auto">
                                <table class="w-full border">
                                    <thead class="p-3">
                                        <tr class="border">
                                            <th>Meal Name</th>
                                            <th>Recipe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <%- favorites %>
                                    </tbody>
                                    <tfoot>
            
                                    </tfoot>
                                </table>
            
                            </div>
                        </div>
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Meal Inventory</h1>
                                <div class='h-full border shadow-xl relative bg-slate-800'>
                                <div id="inventoryManager" class="flex flex-col w-full h-full" method="post">
                                    <!-- Have the submit button change from enter to remove when clicking boxes or entering info -->
                                     <div id="drinkInventoryBox" class="p-5 max-h-4/5 overflow-y-auto">
                                        <%- inventory %>
                                     </div>
                                    <button id="backBtn" class="hidden absolute top-3 right-3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(2,<%-cnt-%>) type="button">Back</button>
                                    <input class="hidden absolute bottom-0 w-9/10 p-5 bg-white text-black h-1/5" id="myInput" type="text" name="ingredient" placeholder="Enter a drink like chocolate!">
                                    <button id="submitItem"class="hidden bottom-0 right-0 w-1/10 absolute h-1/5 bg-blue-800 inset-ring-3 shadow-xl text-white p-3" type ='button' onclick=selectAction(4,<%-cnt-%>)> Submit </button>
                                    <button id="addInven" class="absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(0,<%-cnt-%>) type="button">Add</button>
                                    <button id="rmInven" class="absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(1,<%-cnt-%>) type="button">Remove</button>
                                    <button id="backBtn2" class="hidden absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(3,<%-cnt-%>) type="button">Back</button>
                                    <button id="rmInven2" class="hidden absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(5,<%-cnt-%>) type="button">Remove</button>
                                </div>
                                <div id="drinkAlert" class="hidden absolute -bottom-10 w-full p-3 bg-red-600">
                                    <span class="absolute right-3 text-xl" onclick="this.parentElement.style.display='none';">&times;X</span>
                                    This is an alert box.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class ='relative h-full col-span-2 m-5 overflow-y-scroll'>
                        <h1 class="text-center text-xl">Meal Finder</h1>
                        <form class="my-10 w-full" method="post" action = 'processMealFilter'>
                            <fieldset>
                                <label for="category">Choose a Category</label> 
                                <select class="bg-gray-700" name ='category' required>
                                    <option value="None" selected>None</option>
                                    <option value="Asian">Asian</option>
                                    <option value="American">American</option>
                                    <option value="British">British</option>
                                    <option value="Cajun">Cajun</option>
                                    <option value="Carribbean">Carribbean</option>
                                    <option value="Chinese">Chinese</option>
                                    <option value="European">European</option>
                                    <option value="German">German</option>
                                    <option value="Indian">Indian</option>
                                    <option value="Japanese">Japanese</option>
                                    <option value="Jewish">Jewish</option>
                                    <option value="Korean">Korean</option> 
                                </select>
                                <label for="maxCal">Max Calories</label>
                                <input class="bg-gray-700" type="number" name="maxCal" min="50" max = '800'>
                                <label for="maxSer">Max Servings</label>
                                <input class="bg-gray-700" type="number" name="maxSer" min="1" max = '8'>
                                <label for="maxSug">Max Sugar</label>
                                <input class="bg-gray-700" type="number" name="maxSug" min="1" max = '100'>
                                <label class="mb-2.5" for="allergies">Allergies: </label>
                                <select size="2" class="absolute w-50 bg-gray-700 border rounded-base px-3 py-2.5 shadow-xs" name="allergies" multiple>
                                    <option value="None" selected>None</option>
                                    <option value="Dairy">Dairy</option>
                                    <option value="Egg">Egg</option>
                                    <option value="Gluten">Gluten</option>
                                    <option value="Grain">Grain</option>
                                    <option value="Peanut">Peanut</option>
                                    <option value="Seafood">Seafood</option>
                                    <option value="Sesame">Sesame</option>
                                    <option value="Shellfish">Shellfish</option>
                                    <option value="Soy">Soy</option>
                                    <option value="Sulfite">Sulfite</option>
                                    <option value="Tree_Nut">Tree Nut</option>
                                    <option value="Wheat">Wheat</option>
                                </select>
                            </fieldset>
                            <br>
                            
                            <input type="submit" value="submit">
                        </form>
                        <br>
                        <table class="w-full bg-slate-800 border border-white">
                            <thead>
                                <tr>
                                    <th class="w-2/3">Meal Name</th>
                                    <th class="w-1/3">More Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%- entries %>
                            </tbody>
                            <tfoot>
        
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="h-1/7 flex-none w-screen bg-black"></div>
            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

    </body>
    <script type="text/javascript" src="/favoriteToggle.js"></script>
</html>