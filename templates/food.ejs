<!DOCTYPE HTML>
<html>
    <head>
        <meta charset="utf-8">
        <title>Drink Curator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        <script src="/editInventory.js"></script>
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include ('nav'); -%>
        <% if (user != 'guest') {%>
            <main class="h-screen flex flex-col">
                <div class="h-1/7 flex-none w-screen bg-black"></div>
                <div class="bg-emerald-950 h-4/5 flex flex-col text-white">
                    <div class="max-h-1/2 h-full flex flex-row">
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Favorite Meal</h1>
                            <div class="h-full border shadow-xl bg-slate-800 overflow-y-auto">
                                <table class="w-full border">
                                    <thead class="p-3">
                                        <tr class="border">
                                            <th>Meal Name</th>
                                            <th>Recipe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <%- favorites %>
                                    </tbody>
                                    <tfoot>
            
                                    </tfoot>
                                </table>
            
                            </div>
                        </div>
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Meal Inventory</h1>
                                <div class='h-full border shadow-xl relative bg-slate-800'>
                                <div id="inventoryManager" class="flex flex-col w-full h-full" method="post">
                                    <!-- Have the submit button change from enter to remove when clicking boxes or entering info -->
                                     <div id="foodInventory" class="p-5 max-h-4/5 overflow-y-auto">
                                        <%- inventory %>
                                     </div>
                                    <button id="backBtn" class="hidden absolute top-3 right-3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectFoodAction(2,<%-cnt-%>) type="button">Back</button>
                                    <input class="hidden absolute bottom-0 w-9/10 p-5 bg-white text-black h-1/5" id="myInput" type="text" name="ingredient" placeholder="Enter a recipe item like apricots or andouille sausage">
                                    <button id="submitItem"class="hidden bottom-0 right-0 w-1/10 absolute h-1/5 bg-blue-800 inset-ring-3 shadow-xl text-white p-3" type ='button' onclick=selectFoodAction(4,<%-cnt-%>)> Submit </button>
                                    <button id="addInven" class="absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectFoodAction(0,<%-cnt-%>) type="button">Add</button>
                                    <button id="rmInven" class="absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectFoodAction(1,<%-cnt-%>) type="button">Remove</button>
                                    <button id="backBtn2" class="hidden absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectFoodAction(3,<%-cnt-%>) type="button">Back</button>
                                    <button id="rmInven2" class="hidden absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectFoodAction(5,<%-cnt-%>) type="button">Remove</button>
                                </div>
                                <div id="drinkAlert" class="hidden absolute -bottom-10 w-full p-3 bg-red-600">
                                    <span class="absolute right-3 text-xl" onclick="this.parentElement.style.display='none';">&times;X</span>
                                    This is an alert box.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class ='relative h-full col-span-2 m-5 overflow-y-scroll'>
                        <h1 class="text-center text-xl">Meal Finder</h1>
                        <form class="my-10 w-full" method="post" action = 'processMealFilter'>
                            <fieldset>
                                <label for="category">Choose a Category</label> 
                                <select class="bg-gray-700" name ='category' required>
                                    <%- categories %>
                                </select>
                                <%- calories %>
                                <%- servings %>
                                <%- sugar %>
                                <label class="mb-2.5" for="allergies">Allergies: </label>
                                <div  class="inline-block relative flex flex-col w-50  justify-center">
                                    <button id="showAllergies" type="button" onclick="showAllergens()" class="alg w-full rounded-full inset-ring-1 bg-gray-700">No Allergies Selected</button>
                                    <div id="allergyList" class="hidden absolute w-full left-0 bg-gray-700">
                                        <%- allergies %>
                                    </div>
                                </div>
                            </fieldset>
                            <br>
                            
                            <input class="bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" type="submit" value="submit">
                        </form>
                        <br>
                        <table class="w-full bg-slate-800 border border-white">
                            <thead>
                                <tr>
                                    <th class="w-2/3">Meal Name</th>
                                    <th class="w-1/3">More Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%- entries %>
                            </tbody>
                            <tfoot>
        
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="h-1/7 flex-none w-screen bg-black"></div>
            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

    </body>
    <script type="text/javascript" src="/favoriteToggle.js"></script>
    <script>
        let checkBoxDivs = document.getElementById("allergyList").children;
        let checkBoxes = [];
        let count = 0;
        // Can Alter this to Make the allergies sync from server to client
        for(let i = 0; i< checkBoxDivs.length; i++){
            checkBoxes.push(checkBoxDivs[i].children[1]);
            if (checkBoxDivs[i].children[1].checked){
                count++;
            }
        }
        checkBoxes.forEach((checkBox) => {
            checkBox.addEventListener("change", (e) => {
                // console.log(e.target);
                if(e.target.checked){
                    count++;
                } else {
                    count--;
                }
                if (count <= 0 ) {
                    document.getElementById("showAllergies").innerHTML = `No Allergies Selected`;
                } else {
                    document.getElementById("showAllergies").innerHTML = `${count} Allergies Selected`;
                }
                
            })
        })
        function showAllergens(){
            document.getElementById("allergyList").classList.toggle("hidden");
        }
        document.getElementById("allergyList").addEventListener('click', function (event) {
            event.stopPropagation();
        });
        window.onclick = function(event) {
            if (!event.target.matches('.alg')) {
                let dropdowns = document.getElementById("allergyList").classList;
                if(!dropdowns.contains("hidden")){
                    document.getElementById("allergyList").classList.toggle("hidden");
                }
                
            }
        }

        window.onload = () => {
            console.log(count);
            if (count <= 0 ) {
                document.getElementById("showAllergies").innerHTML = `No Allergies Selected`;
            } else {
                document.getElementById("showAllergies").innerHTML = `${count} Allergies Selected`;
            }
        }
    </script>
</html>