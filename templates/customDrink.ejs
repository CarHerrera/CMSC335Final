<!DOCTYPE HTML>
<html>
    <head>
        <meta charset="utf-8">
        <title>Recipe Generator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include('nav'); -%>
        <% if (user != 'guest') {%>
            <main class="h-screen grid grid-rows-8"">
                <div class="bg-emerald-950 row-start-2 row-span-5 text-white flex flex-col justify-center items-center overflow-auto p-10">
                        <h1 class="pt-10"><%= drinkName %></h1>
                        <!-- <a class="fa fa-star" id="favoriteButton" href="addFavoriteDrink/<%-id%>"></a> -->
                    
                    <br>
                        <%- image %>
                    <br>
                    <div>
                        <h2>Ingredients</h2>
                        <br>
                        <%- ingredients %>    
                    </div>
                    <div>
                        <h3>Instructions</h3>
                        <br>
                        <%- instructions%>    
                    </div>
                    
    
                </div>
    
            </main> 
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

        
    </body>
</html>