<!DOCTYPE HTML>
<html>
    <head>
        <title>Drink Curator</title>
        <%- include('headers'); -%>
        <script src="<%= baseUrl %>editInventory.js"></script>
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include ('nav'); -%>
        <% if (user != 'guest') {%>
           <main class="h-screen flex flex-col">
                <div class="h-1/7 flex-none w-screen bg-black">
                    <% if(EmptyInv == true) { %>
                        <p class="text-red-400">Please add items to your inventory before running this query.</p>
                    <% } %>
                </div>
                <div class="bg-emerald-950 h-4/5 flex flex-col text-white">
                    <div class="max-h-1/2 h-full flex flex-row">
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Favorite Drinks</h1>
                            <div class="h-full border shadow-xl bg-slate-800 overflow-y-auto">
                                <table  class="w-full border">
                                    <thead class="p-3">
                                        <tr class="border">
                                            <th>Drink Name</th>
                                            <th>Recipe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <%- favorites %>
                                    </tbody>
                                    <tfoot>
            
                                    </tfoot>
                                </table>
            
                            </div>
                        </div>
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Drink Inventory</h1>
                            <div class='h-full border shadow-xl relative bg-slate-800'>
                                <div id="inventoryManager" class="flex flex-col w-full h-full" method="post">
                                    <!-- Have the submit button change from enter to remove when clicking boxes or entering info -->
                                     <div id="drinkInventoryBox" class="p-5 max-h-4/5 overflow-y-auto">
                                        <%- inventory %>
                                     </div>
                                    <button id="backBtn" class="hidden absolute top-3 right-3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(2,<%-cnt-%>) type="button">Back</button>
                                    <input class="hidden absolute bottom-0 w-9/10 p-5 bg-white text-black h-1/5" id="myInput" type="text" name="ingredient" placeholder="Enter a drink like chocolate!">
                                    <button id="submitItem"class="hidden bottom-0 right-0 w-1/10 absolute h-1/5 bg-blue-800 inset-ring-3 shadow-xl text-white p-3" type ='button' onclick=selectAction(4,<%-cnt-%>)> Submit </button>
                                    <button id="addInven" class="absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(0,<%-cnt-%>) type="button">Add</button>
                                    <button id="rmInven" class="absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(1,<%-cnt-%>) type="button">Remove</button>
                                    <button id="backBtn2" class="hidden absolute bottom-4 left-1/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(3,<%-cnt-%>) type="button">Back</button>
                                    <button id="rmInven2" class="hidden absolute bottom-4 left-2/3 bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" onclick=selectAction(5,<%-cnt-%>) type="button">Remove</button>
                                </div>
                                <div id="drinkAlert" class="hidden absolute -bottom-10 w-full p-3 bg-red-600">
                                    <span class="absolute right-3 text-xl" onclick="this.parentElement.style.display='none';">&times;X</span>
                                </div>
                            </div>
                            
                        </div>
                        
                    </div>
                    
                    <div class ='h-full col-span-2 m-5 overflow-y-scroll'>
                        <h1 class="text-center text-xl">Drink Finder</h1>
                        <div class = "flex justify-evenly">
                            <form method="post" action = 'processFilters'>
                                <fieldset>
                                    <label for="category">Choose a Category</label>
                                    <select class="bg-gray-700" name="category">
                                        <%- categories %>
                                    </select>    
                                </fieldset>
                                <br>
                                
                                <button class="bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" type="submit" value="submit">Submit Category Search</button>
                            </form>
                            
                            <form class ="" method="post" action = 'processInventory'>
                                <fieldset>
                                    <label for="category">Search based off of your inventory!</label>
                                    
                                </fieldset>
                                <br>
                                
                                <button class="bg-blue-800 rounded-full inset-ring-3 shadow-xl text-white p-3" type="submit" value="submit">Submit Inventroy Search</button>
                            </form>
                        </div>
                        
                        <br>
                        <table class="w-full bg-slate-800 border border-white">
                            <thead>
                                <tr>
                                    <th class="w-2/3">Drink Name</th>
                                    <th class="w-1/3">More Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%- entries %>
                            </tbody>
                            <tfoot>
        
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="h-1/7 flex-none w-screen bg-black"></div>
            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

    </body>
    <script src="<%= baseUrl %>autoComplete.js"></script>
</html>