<!DOCTYPE HTML>
<html>
    <head>
        <meta charset="utf-8">
        <title>Drink Curator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include ('nav'); -%>
        <% if (user != 'guest') {%>
           <main class="h-screen grid grid-rows-8">
                <div class="bg-emerald-950 row-start-2 row-span-5 grid grid-cols-2 text-white">
                    <div class ='flex flex-col m-5'>
                        <h1 class="my-5">Favorite Drinks</h1>
                        <div class="flex-grow bg-slate-800">
                            <table id="recTable">
                                <thead>
                                    <tr>
                                        <th>Drink Name</th>
                                        <th>Recipe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <%- favorites %>
                                </tbody>
                                <tfoot>
        
                                </tfoot>
                            </table>
        
                        </div>
                    </div>
                    <div class ='flex flex-col m-5'>
                        <h1 class="my-5">Drink Inventory</h1>
                        <div class='relative flex-grow bg-slate-800'>
                            <form action="remove" method="post">
                                <%- inventory %>
                                <input type ='submit' value="Remove" class="absolute inset-x-0 bottom-0"> 
                            </form>
                        </div>
                    </div>
                    <div class ='col-span-2 m-5 overflow-y-auto'>
                        <h1>Drink Finder</h1>
                        <form method="post" action = 'processFilters'>
                            <fieldset>
                                <label for="category">Choose a Category</label>
                                <select name="category">
                                    <%- categories %>
                                </select>    
                            </fieldset>
                            <br>
                            
                            <input type="submit" value="submit">
                        </form>
                        <br>
                        <table id="" class="w-screen ">
                            <thead>
                                <tr>
                                    <th class="w-2/3">Drink Name</th>
                                    <th class="w-1/3">More Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%- entries %>
                            </tbody>
                            <tfoot>
        
                            </tfoot>
                        </table>
                    </div>
                </div>

            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

    </body>
    <script type="text/javascript" src="/favoriteToggle.js"></script>
</html>