<!DOCTYPE HTML>
<html>
    <head>
        <meta charset="utf-8">
        <title>Drink Curator</title>
        <link rel="stylesheet" type="text/css" href="/tailwind.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        
    </head>
    <body class="bg-black md:w-screen h-screen">
        <%- include ('nav'); -%>
        <% if (user != 'guest') {%>
           <main class="h-screen flex flex-col">
                <div class="h-1/7 flex-none w-screen bg-black"></div>
                <div class="bg-emerald-950 h-4/5 flex flex-col text-white">
                    <div class="h-full flex flex-row">
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Favorite Drinks</h1>
                            <div class="h-full flex-grow bg-slate-800">
                                <table id="recTable">
                                    <thead>
                                        <tr>
                                            <th>Drink Name</th>
                                            <th>Recipe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <%- favorites %>
                                    </tbody>
                                    <tfoot>
            
                                    </tfoot>
                                </table>
            
                            </div>
                        </div>
                        <div class ='w-1/2 flex flex-col m-5'>
                            <h1 class="my-5">Drink Inventory</h1>
                            <div class='relative flex-grow bg-slate-800'>
                                <form action="/addDrink" class="flex" method="post">
                                    <!-- Have the submit button change from enter to remove when clicking boxes or entering info -->
                                    <%- inventory %>
                                    
                                    <input class="absolute bottom-0 w-9/10 p-5 bg-white text-black h-1/5" id="myInput" type="text" name="ingredient" placeholder="Corn">
                                    <input class="absolute right-0 bottom-0 p-5 w-1/10 h-1/5" type ='submit' value="submit" > 
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <div class ='h-full col-span-2 m-5 overflow-y-scroll'>
                        <h1>Drink Finder</h1>
                        <form method="post" action = 'processFilters'>
                            <fieldset>
                                <label for="category">Choose a Category</label>
                                <select class="bg-gray-700" name="category">
                                    <%- categories %>
                                </select>    
                            </fieldset>
                            <br>
                            
                            <input type="submit" value="submit">
                        </form>
                        <br>
                        <table id="" class="w-screen ">
                            <thead>
                                <tr>
                                    <th class="w-2/3">Drink Name</th>
                                    <th class="w-1/3">More Information</th>
                                </tr>
                            </thead>
                            <tbody>
                                <%- entries %>
                            </tbody>
                            <tfoot>
        
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="h-1/7 flex-none w-screen bg-black"></div>
            </main>
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

    </body>
    <script src="/autoComplete.js"></script>
</html>