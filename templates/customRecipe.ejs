<!DOCTYPE HTML>
<html>
    <head>
        <%- include('headers'); -%>
        <title>Meal Curator</title>
        <script src="/favoriteToggle.js"></script>
    </head>
    <body class="bg-black md:w-screen h-dvh">
        <%- include('nav'); -%>
        <% if (user != 'guest') {%>
            <main class="h-screen flex flex-col">
                <div class="h-1/5 flex-none w-screen bg-black">
                    <% if(quotaError == true) { %>
                        <p class="text-red-400">Unfortunately, some features are unavailable due to a low balance. Please come back tomorrow to try again.</p>
                    <% } %>
                </div>
                <div class=" bg-emerald-950 flex flex-col text-white justify-center items-center gap-8 px-[30vw] p-5">
                    <div class="m-5 w-xl flex-1/10 flex flex-row">
                        <h1 class="text-6xl"><%= recipeName %></h1>
                        <div class="flex-grow"></div>
                        <% if (fav == true) {%>
                            <a class="fa fa-star checked" style="font-size:xx-large;margin-top:15px;" id=<%-id-%> onclick=toggleRecipe(<%-id-%>,"<%-recipeEncode %>")></a>
                        <%} else {%>
                            <a class="fa fa-star" style="font-size:xx-large;margin-top:15px;" id=<%-id-%> onclick=toggleRecipe(<%-id-%>,"<%-recipeEncode %>")></a>
                        <%}%>
                        
                    </div>                        
                    <div class="shrink">
                        <img class="rounded-full border-2 inset-0" src=<%= image %>>
                    </div>
                        
                    <div class="flex-2/10 w-1/3 justify-center">
                        <h2 class="text-5xl">Ingredients</h2>
                        <br>
                        <%- ingredients %>    
                    </div>
                    <div class="flex-2/10 w-1/3 justify-center">
                        <h2 class="text-5xl">Instructions</h2>
                        <br>
                        <%- instructions%>    
                    </div>
                    
    
                </div>
                <div class="h-1/5 flex-none w-screen bg-black"></div>
            </main> 
        <%} else {%>
                <%- include('error'); -%>
        <%}%>

        
    </body>
</html>